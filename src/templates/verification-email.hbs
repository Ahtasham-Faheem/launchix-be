<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Verify Your Email - Launchix AI</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: #f6f8fb;
      color: #333;
      padding: 40px;
    }
    .container {
      max-width: 500px;
      margin: auto;
      background: white;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }
    .logo {
      text-align: center;
      font-size: 28px;
      font-weight: 700;
      color: #3b82f6;
      margin-bottom: 20px;
    }
    .code {
      font-size: 30px;
      letter-spacing: 6px;
      background: #eef3ff;
      color: #2563eb;
      padding: 10px 20px;
      border-radius: 8px;
      text-align: center;
      display: block;
      margin: 20px 0;
    }
    .footer {
      text-align: center;
      color: #777;
      font-size: 12px;
      margin-top: 25px;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="logo">Launchix AI</div>
    <p>Hi there,</p>
    <p>
    {{#if resend}}
        You requested a new verification code for Launchix AI. Here it is:
    {{else}}
        Welcome to Launchix AI! Please verify your email using the code below:
    {{/if}}
    </p>
    <div class="code">{{code}}</div>
    <p>This code will expire in 15 minutes.</p>
    <p>If you didn’t sign up, you can ignore this email.</p>
    <div class="footer">© {{year}} Launchix AI. All rights reserved.</div>
  </div>
</body>
</html>
