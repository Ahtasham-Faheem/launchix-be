# ─────────────────────────────
# General Configuration
# ─────────────────────────────
PORT=4242
NODE_ENV=development

# ─────────────────────────────
# Database (MongoDB)
# ─────────────────────────────
# Local Mongo instance or MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/launchixai

# ─────────────────────────────
# CORS
# ─────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ─────────────────────────────
# Clerk Authentication
# ─────────────────────────────
# Clerk JWT issuer and audience for backend verification
CLERK_JWT_ISSUER=https://clerk.YOUR_INSTANCE_ID.clerk.accounts.dev
CLERK_JWT_AUDIENCE=authenticated

# ─────────────────────────────
# OpenAI
# ─────────────────────────────
# API key for GPT + DALL·E models
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY

# ─────────────────────────────
# AWS S3
# ─────────────────────────────
# S3 bucket name and base URL for uploaded assets
S3_BUCKET=your-s3-bucket-name
S3_PUBLIC_BASE=https://your-s3-bucket-name.s3.amazonaws.com/

# Optional: specify region if needed
AWS_REGION=us-east-1

# ─────────────────────────────
# Rate Limiting
# ─────────────────────────────
# TTL = seconds, LIMIT = requests per TTL
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120

# ─────────────────────────────
# Logging
# ─────────────────────────────
# Adjust NestJS Pino log level: 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=debug

# ─────────────────────────────
# SafePay Configuration
# ─────────────────────────────
# SafePay API credentials for payment processing
SAFEPAY_SECRET_KEY=your_secret_key_here
SAFEPAY_API_KEY=your_merchant_api_key_here

# Frontend URL for payment redirects
FRONTEND_URL=http://localhost:3000
SAFEPAY_MERCHANT_API_KEY=your_merchant_api_key_here